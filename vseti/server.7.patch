+var reYtId = regexp.MustCompile(`(?:youtube\.com/(?:watch\?(?:.*&)?v=|shorts/|embed/|live/)|youtu\.be/)([A-Za-z0-9_-]{11})`)
+
+// vsYouTube — YouTube из России напрямую недоступен: название берём через noembed.com,
+// обложку — через прокси картинок wsrv.nl.
+func vsYouTube(ctx context.Context, u, id string) *mtproto.WebPage {
+	var title, author string
+	if b, _, err := vsGet(ctx, "https://noembed.com/embed?url="+url.QueryEscape("https://www.youtube.com/watch?v="+id), 256*1024); err == nil {
+		var j struct {
+			Title      string `json:"title"`
+			AuthorName string `json:"author_name"`
+		}
+		if json.Unmarshal(b, &j) == nil {
+			title, author = j.Title, j.AuthorName
+		}
+	}
+	if title == "" {
+		return nil
+	}
+	h := fnv.New64a()
+	h.Write([]byte(u))
+	wid := int64(h.Sum64() & 0x7fffffffffffffff)
+	wp := &mtproto.WebPage{
+		Id:            wid,
+		Url_STRING:    u,
+		DisplayUrl:    strings.TrimPrefix(strings.TrimPrefix(u, "https://"), "http://"),
+		Hash:          int32(wid),
+		Type:          wrapperspb.String("video"),
+		SiteName:      wrapperspb.String("YouTube"),
+		Title:         wrapperspb.String(vsCut(title, 256)),
+		EmbedUrl:      wrapperspb.String("https://www.youtube.com/embed/" + id),
+		EmbedType:     wrapperspb.String("iframe"),
+		EmbedWidth:    wrapperspb.Int32(1280),
+		EmbedHeight:   wrapperspb.Int32(720),
+		HasLargeMedia: true,
+		Attributes:    []*mtproto.WebPageAttribute{},
+	}
+	if author != "" {
+		wp.Description = wrapperspb.String(vsCut(author, 256))
+		wp.Author = wrapperspb.String(vsCut(author, 128))
+	}
+	for _, q := range []string{"maxresdefault", "hqdefault"} {
+		img := "https://wsrv.nl/?url=i.ytimg.com/vi/" + id + "/" + q + ".jpg"
+		if data, ct, err := vsGet(ctx, img, 5*1024*1024); err == nil && strings.HasPrefix(ct, "image/") && len(data) > 2000 {
+			wp.Photo = vsUploadPhoto(ctx, data)
+			break
+		}
+	}
+	return mtproto.MakeTLWebPage(wp).To_WebPage()
+}
