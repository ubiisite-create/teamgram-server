diff --git a/app/bff/bff/internal/server/vs_gifsearch.go b/app/bff/bff/internal/server/vs_gifsearch.go
new file mode 100644
index 0000000..5905bca
--- /dev/null
+++ b/app/bff/bff/internal/server/vs_gifsearch.go
@@ -0,0 +1,175 @@
+// VSети: поиск GIF через служебного бота @gif (как в Telegram: вкладка GIF → строка поиска → inline-бот @gif).
+// Бесплатно, без сторонних сервисов: ищем по своей базе — гифкам, которые отправляли в VSети
+// (слова из подписи и имени файла). Пустой запрос — самые популярные.
+package server
+
+import (
+	"context"
+	"math/rand"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+
+	"github.com/teamgram/proto/mtproto"
+	"github.com/teamgram/teamgram-server/pkg/vsstickers"
+
+	"github.com/zeromicro/go-zero/core/logx"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/types/known/wrapperspb"
+)
+
+var vsMessagesRef interface {
+	MessagesSendMedia(ctx context.Context, in *mtproto.TLMessagesSendMedia) (*mtproto.Updates, error)
+}
+
+const vsGifPage = 50
+
+// vsGifWords — слова для поиска: подпись + имя файла, в нижнем регистре, без повторов.
+func vsGifWords(parts ...string) []string {
+	seen := map[string]bool{}
+	var r []string
+	for _, p := range parts {
+		for _, w := range strings.FieldsFunc(strings.ToLower(p), func(c rune) bool {
+			return !unicode.IsLetter(c) && !unicode.IsDigit(c)
+		}) {
+			if len([]rune(w)) < 2 || seen[w] {
+				continue
+			}
+			switch w {
+			case "mp4", "gif", "img", "vid", "video", "animation", "giphy", "tenor":
+				continue
+			}
+			if _, err := strconv.Atoi(w); err == nil {
+				continue // номера в именах файлов
+			}
+			seen[w] = true
+			r = append(r, w)
+		}
+	}
+	return r
+}
+
+func vsGifIndexAdd(ctx context.Context, d *mtproto.Document, caption string) {
+	name := ""
+	for _, a := range d.GetAttributes() {
+		if a.GetPredicateName() == mtproto.Predicate_documentAttributeFilename {
+			name = strings.TrimSuffix(a.GetFileName(), filepath.Ext(a.GetFileName()))
+		}
+	}
+	var old string
+	_ = vsDB.QueryRowContext(ctx, "select words from vs_gif_index where document_id = ?", d.GetId()).Scan(&old)
+	words := strings.Join(vsGifWords(old, caption, name), " ")
+	if len(words) > 500 {
+		words = words[:500]
+	}
+	_, err := vsDB.ExecContext(ctx, "insert into vs_gif_index(document_id, words, uses, last_used) values (?, ?, 1, ?) "+
+		"on duplicate key update words = values(words), uses = uses + 1, last_used = values(last_used)",
+		d.GetId(), words, time.Now().Unix())
+	if err != nil {
+		logx.WithContext(ctx).Errorf("vs gif index: %v", err)
+	}
+}
+
+func vsGifSearch(ctx context.Context, q string, offset, limit int) []int64 {
+	words := vsGifWords(q)
+	sqlq := "select document_id from vs_gif_index"
+	var args []any
+	if len(words) > 0 {
+		var conds []string
+		for _, w := range words {
+			conds = append(conds, "words like ?")
+			args = append(args, "%"+w+"%")
+		}
+		sqlq += " where " + strings.Join(conds, " and ")
+	}
+	sqlq += " order by uses desc, last_used desc limit ? offset ?"
+	args = append(args, limit, offset)
+	rows, err := vsDB.QueryContext(ctx, sqlq, args...)
+	if err != nil {
+		logx.WithContext(ctx).Errorf("vs gif search: %v", err)
+		return nil
+	}
+	defer rows.Close()
+	var ids []int64
+	for rows.Next() {
+		var id int64
+		if rows.Scan(&id) == nil {
+			ids = append(ids, id)
+		}
+	}
+	return ids
+}
+
+type vsInlineBot struct {
+	mtproto.UnimplementedRPCInlineBotServer
+}
+
+func (vsInlineBot) MessagesGetInlineBotResults(ctx context.Context, in *mtproto.TLMessagesGetInlineBotResults) (*mtproto.Messages_BotResults, error) {
+	if in.GetBot().GetUserId() != vsstickers.GifBotId {
+		return nil, status.Error(mtproto.ErrBadRequest, "BOT_INLINE_DISABLED")
+	}
+	r := &mtproto.Messages_BotResults{
+		Gallery:   true,
+		QueryId:   rand.Int63(),
+		Results:   []*mtproto.BotInlineResult{},
+		CacheTime: 30,
+		Users:     []*mtproto.User{},
+	}
+	if vsDB != nil {
+		offset, _ := strconv.Atoi(in.GetOffset())
+		ids := vsGifSearch(ctx, in.GetQuery(), offset, vsGifPage+1)
+		if len(ids) > vsGifPage {
+			ids = ids[:vsGifPage]
+			r.NextOffset = wrapperspb.String(strconv.Itoa(offset + vsGifPage))
+		}
+		for _, d := range vsDocs(ctx, ids) {
+			r.Results = append(r.Results, mtproto.MakeTLBotInlineMediaResult(&mtproto.BotInlineResult{
+				Id:       strconv.FormatInt(d.GetId(), 10),
+				Type:     "gif",
+				Document: d,
+				SendMessage: mtproto.MakeTLBotInlineMessageMediaAuto(&mtproto.BotInlineMessage{
+					Message: "",
+				}).To_BotInlineMessage(),
+			}).To_BotInlineResult())
+		}
+	}
+	return mtproto.MakeTLMessagesBotResults(r).To_Messages_BotResults(), nil
+}
+
+func (vsInlineBot) MessagesSendInlineBotResult(ctx context.Context, in *mtproto.TLMessagesSendInlineBotResult) (*mtproto.Updates, error) {
+	id, err := strconv.ParseInt(in.GetId(), 10, 64)
+	if err != nil || vsMessagesRef == nil {
+		return nil, status.Error(mtproto.ErrBadRequest, "RESULT_ID_INVALID")
+	}
+	d := vsDoc(ctx, id)
+	if d == nil || !vsDocIsGif(d) {
+		return nil, status.Error(mtproto.ErrBadRequest, "RESULT_ID_INVALID")
+	}
+	req := &mtproto.TLMessagesSendMedia{
+		Silent:       in.GetSilent(),
+		Background:   in.GetBackground(),
+		ClearDraft:   in.GetClearDraft(),
+		Peer:         in.GetPeer(),
+		ReplyTo:      in.GetReplyTo(),
+		ReplyToMsgId: in.GetReplyToMsgId(),
+		TopMsgId:     in.GetTopMsgId(),
+		Media: mtproto.MakeTLInputMediaDocument(&mtproto.InputMedia{
+			Id_INPUTDOCUMENT: mtproto.MakeTLInputDocument(&mtproto.InputDocument{
+				Id:            d.GetId(),
+				AccessHash:    d.GetAccessHash(),
+				FileReference: d.GetFileReference(),
+			}).To_InputDocument(),
+		}).To_InputMedia(),
+		Message:      "",
+		RandomId:     in.GetRandomId(),
+		ScheduleDate: in.GetScheduleDate(),
+		SendAs:       in.GetSendAs(),
+	}
+	resp, err := vsMessagesRef.MessagesSendMedia(ctx, req)
+	if err == nil && resp != nil {
+		go vsAfterSendMedia(context.WithoutCancel(ctx), "", resp)
+	}
+	return resp, err
+}
