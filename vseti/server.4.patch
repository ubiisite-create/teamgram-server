+// ensureGifBot — служебный бот @gif для поиска GIF (как в Telegram: gif_search_username = gif).
+func ensureGifBot(ctx context.Context, db *sql.DB, rds []*redis.Redis) {
+	id := vsstickers.GifBotId
+	var name string
+	err := db.QueryRowContext(ctx, "select username from users where id = ?", id).Scan(&name)
+	switch {
+	case err == sql.ErrNoRows:
+		_, err = db.ExecContext(ctx, "insert into users(id, user_type, access_hash, first_name, last_name, username, phone, country_code, is_bot, about) values (?, 3, ?, 'GIF', '', ?, '', '', 1, ?)",
+			id, setAccessHash(id), vsstickers.GifBotUsername, "Поиск GIF в VSети")
+		must(err, "users @gif")
+	case err != nil:
+		must(err, "users @gif select")
+	case name != vsstickers.GifBotUsername:
+		fmt.Printf("ВНИМАНИЕ: id %d занят пользователем %q — бот @gif не создан\n", id, name)
+		return
+	}
+	var n int
+	_ = db.QueryRowContext(ctx, "select count(*) from bots where bot_id = ?", id).Scan(&n)
+	if n == 0 {
+		_, err = db.ExecContext(ctx, "insert into bots(bot_id, bot_type, creator_user_id, bot_nochats, bot_inline_placeholder) values (?, 1, 0, 1, ?)", id, vsstickers.GifBotPlaceholder)
+		must(err, "bots @gif")
+	} else {
+		_, _ = db.ExecContext(ctx, "update bots set bot_inline_placeholder = ? where bot_id = ?", vsstickers.GifBotPlaceholder, id)
+	}
+	var peer int64
+	err = db.QueryRowContext(ctx, "select peer_id from username where username = ? and deleted = 0", vsstickers.GifBotUsername).Scan(&peer)
+	switch {
+	case err == sql.ErrNoRows:
+		_, err = db.ExecContext(ctx, "insert into username(username, peer_type, peer_id) values (?, 2, ?)", vsstickers.GifBotUsername, id)
+		must(err, "username @gif")
+	case err == nil && peer != id:
+		fmt.Printf("ВНИМАНИЕ: имя @gif уже занято (peer %d)\n", peer)
+	}
+	for _, r := range rds {
+		_, _ = r.Del(fmt.Sprintf("user_%d", id), fmt.Sprintf("bots_%d", id))
+	}
+	fmt.Println("бот @gif готов")
+}
