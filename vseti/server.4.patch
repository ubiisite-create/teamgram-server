+// ---------- GIF: служебный бот @gif и своя база гифок ----------
+
+const (
+	GifBotId          = int64(777010)
+	GifBotUsername    = "gif"
+	GifBotPlaceholder = "Поиск GIF"
+)
+
+// GifSchema — индекс гифок, которые отправляли в VSети (слова из подписи и имени файла, популярность).
+var GifSchema = "CREATE TABLE IF NOT EXISTS `vs_gif_index` (" +
+	"`document_id` bigint NOT NULL, `words` varchar(512) NOT NULL DEFAULT '', " +
+	"`uses` int NOT NULL DEFAULT 0, `last_used` int NOT NULL DEFAULT 0, " +
+	"PRIMARY KEY (`document_id`), KEY `uses` (`uses`, `last_used`)" +
+	") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
+
+func init() {
+	Schema = append(Schema, GifSchema)
+}
