+func (s vsStickers) MessagesGetArchivedStickers(ctx context.Context, in *mtproto.TLMessagesGetArchivedStickers) (*mtproto.Messages_ArchivedStickers, error) {
+	r := &mtproto.Messages_ArchivedStickers{Sets: []*mtproto.StickerSetCovered{}}
+	if vsDB == nil || in.GetMasks() || in.GetEmojis() {
+		return mtproto.MakeTLMessagesArchivedStickers(r).To_Messages_ArchivedStickers(), nil
+	}
+	me := s.me(ctx)
+	us := vsUserSets(ctx, me)
+	type row struct {
+		id int64
+		u  *vsUserSet
+	}
+	var rs []row
+	for id, u := range us {
+		if u.archived {
+			rs = append(rs, row{id, u})
+		}
+	}
+	sort.Slice(rs, func(i, j int) bool { return rs[i].u.installed > rs[j].u.installed })
+	r.Count = int32(len(rs))
+	skip := in.GetOffsetId() != 0
+	limit := int(in.GetLimit())
+	if limit <= 0 || limit > 100 {
+		limit = 100
+	}
+	for _, x := range rs {
+		if skip {
+			if x.id == in.GetOffsetId() {
+				skip = false
+			}
+			continue
+		}
+		if set := vsGetSetById(ctx, x.id); set != nil {
+			r.Sets = append(r.Sets, vsCovered(ctx, set, x.u, me, false))
+		}
+		if len(r.Sets) >= limit {
+			break
+		}
+	}
+	return mtproto.MakeTLMessagesArchivedStickers(r).To_Messages_ArchivedStickers(), nil
+}
