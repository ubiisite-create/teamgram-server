+	if vsDB == nil || q == "" {
+		return mtproto.MakeTLMessagesFoundStickerSets(r).To_Messages_FoundStickerSets(), nil
+	}
+	like := "%" + strings.NewReplacer("%", "", "_", "\\_").Replace(q) + "%"
+	cond := ""
+	if in.GetExcludeFeatured() {
+		cond = " and official <> 1"
+	}
+	sets := vsScanSets(vsDB.QueryContext(ctx, "select "+vsSetCols+" from vs_sticker_sets where deleted = 0 and official <> 2"+cond+
+		" and (title like ? or short_name like ?) order by official desc, created_at desc limit 30", like, like))
+	me := s.me(ctx)
+	us := vsUserSets(ctx, me)
+	ids := []int64{}
+	for _, set := range sets {
+		r.Sets = append(r.Sets, vsCovered(ctx, set, us[set.id], me, true))
+		ids = append(ids, set.id)
+	}
+	r.Hash = vsstickers.HashIds(ids)
+	if in.GetHash() != 0 && in.GetHash() == r.Hash {
+		return mtproto.MakeTLMessagesFoundStickerSetsNotModified(nil).To_Messages_FoundStickerSets(), nil
+	}
+	return mtproto.MakeTLMessagesFoundStickerSets(r).To_Messages_FoundStickerSets(), nil
