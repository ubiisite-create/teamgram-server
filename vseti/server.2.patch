+func (s vsStickers) addItem(ctx context.Context, set *vsSet, item *mtproto.InputStickerSetItem, pos int) error {
+	docId := item.GetDocument().GetId()
+	d := vsDoc(ctx, docId)
+	if d == nil || !vsCheckDocMime(d) {
+		return errVsStickerInvalid
+	}
+	emoji := strings.TrimSpace(item.GetEmoji())
+	if emoji == "" || len(emoji) > 60 {
+		return errVsEmojiInvalid
+	}
+	if err := vsSetDocAttrs(ctx, docId, set, strings.Fields(emoji)[0]); err != nil {
+		return err
+	}
+	kw := ""
+	if item.GetKeywords() != nil {
+		kw = item.GetKeywords().GetValue()
+		if len(kw) > 250 {
+			kw = kw[:250]
+		}
+	}
+	_, err := vsDB.ExecContext(ctx, "insert into vs_sticker_set_items(set_id, document_id, emoji, keywords, pos) values (?, ?, ?, ?, ?) "+
+		"on duplicate key update emoji = values(emoji), keywords = values(keywords), pos = values(pos)", set.id, docId, emoji, kw, pos)
+	if err != nil {
+		return errVsInternal
+	}
+	return nil
+}
+
+func (s vsStickers) StickersCheckShortName(ctx context.Context, in *mtproto.TLStickersCheckShortName) (*mtproto.Bool, error) {
+	if vsDB == nil {
+		return nil, errVsInternal
+	}
+	if !reVsShortName.MatchString(in.GetShortName()) {
+		return nil, errVsShortNameInvalid
+	}
+	if vsGetSetByShort(ctx, in.GetShortName()) != nil {
+		return nil, errVsShortNameOccupied
+	}
+	var n int
+	_ = vsDB.QueryRowContext(ctx, "select count(*) from vs_sticker_sets where short_name = ?", in.GetShortName()).Scan(&n)
+	if n > 0 {
+		return nil, errVsShortNameOccupied
+	}
+	return mtproto.BoolTrue, nil
+}
+
+func (s vsStickers) StickersSuggestShortName(ctx context.Context, in *mtproto.TLStickersSuggestShortName) (*mtproto.Stickers_SuggestedShortName, error) {
+	if vsDB == nil {
+		return nil, errVsInternal
+	}
+	base := vsTranslit(in.GetTitle())
+	name := base
+	for i := 0; i < 20; i++ {
+		var n int
+		_ = vsDB.QueryRowContext(ctx, "select count(*) from vs_sticker_sets where short_name = ?", name).Scan(&n)
+		if n == 0 {
+			break
+		}
+		name = fmt.Sprintf("%s_%d", base, 100+rand.Intn(9900))
+	}
+	return mtproto.MakeTLStickersSuggestedShortName(&mtproto.Stickers_SuggestedShortName{ShortName: name}).To_Stickers_SuggestedShortName(), nil
+}
+
+func (s vsStickers) StickersCreateStickerSet(ctx context.Context, in *mtproto.TLStickersCreateStickerSet) (*mtproto.Messages_StickerSet, error) {
+	if vsDB == nil {
+		return nil, errVsInternal
+	}
+	if in.GetMasks() || in.GetEmojis() {
+		return nil, mtproto.ErrEnterpriseIsBlocked
+	}
+	title := strings.TrimSpace(in.GetTitle())
+	if title == "" || len([]rune(title)) > 64 {
+		return nil, errVsTitleInvalid
+	}
+	if _, err := s.StickersCheckShortName(ctx, &mtproto.TLStickersCheckShortName{ShortName: in.GetShortName()}); err != nil {
+		return nil, err
+	}
+	items := in.GetStickers()
+	if len(items) == 0 {
+		return nil, mtproto.ErrStickersEmpty
+	}
+	if len(items) > vsstickers.MaxSetStickers {
+		return nil, errVsStickersTooMuch
+	}
+	first := vsDoc(ctx, items[0].GetDocument().GetId())
+	if first == nil || !vsCheckDocMime(first) {
+		return nil, errVsStickerInvalid
+	}
+	me := s.me(ctx)
+	set := &vsSet{
+		id:         rand.Int63n(1<<62) + 1<<40,
+		accessHash: rand.Int63(),
+		short:      in.GetShortName(),
+		title:      title,
+		creator:    me,
+		kind:       vsstickers.MimeKind(first.GetMimeType()),
+		created:    time.Now().Unix(),
+	}
+	_, err := vsDB.ExecContext(ctx, "insert into vs_sticker_sets(set_id, access_hash, short_name, title, creator_id, official, kind, featured, deleted, created_at) values (?, ?, ?, ?, ?, 0, ?, 0, 0, ?)",
+		set.id, set.accessHash, set.short, set.title, me, set.kind, set.created)
+	if err != nil {
+		logx.WithContext(ctx).Errorf("vs stickers create: %v", err)
+		return nil, errVsShortNameOccupied
+	}
+	for i, it := range items {
+		if err = s.addItem(ctx, set, it, i); err != nil {
+			_, _ = vsDB.ExecContext(ctx, "update vs_sticker_sets set deleted = 1 where set_id = ?", set.id)
+			return nil, err
+		}
+	}
+	vsInstall(ctx, me, set.id, false)
+	return s.result(ctx, set)
+}
+
+func (s vsStickers) StickersAddStickerToSet(ctx context.Context, in *mtproto.TLStickersAddStickerToSet) (*mtproto.Messages_StickerSet, error) {
+	set, err := s.ownSet(ctx, in.GetStickerset())
+	if err != nil {
+		return nil, err
+	}
+	items := vsSetItems(ctx, set.id)
+	if len(items) >= vsstickers.MaxSetStickers {
+		return nil, errVsStickersTooMuch
+	}
+	if err = s.addItem(ctx, set, in.GetSticker(), len(items)); err != nil {
+		return nil, err
+	}
+	return s.result(ctx, set)
+}
+
+func (s vsStickers) renumber(ctx context.Context, setId int64, ids []int64) {
+	for i, id := range ids {
+		_, _ = vsDB.ExecContext(ctx, "update vs_sticker_set_items set pos = ? where set_id = ? and document_id = ?", i, setId, id)
+	}
+}
+
+func (s vsStickers) StickersRemoveStickerFromSet(ctx context.Context, in *mtproto.TLStickersRemoveStickerFromSet) (*mtproto.Messages_StickerSet, error) {
+	if vsDB == nil {
+		return nil, errVsInternal
+	}
+	docId := in.GetSticker().GetId()
+	set, err := s.ownSetByDoc(ctx, docId)
+	if err != nil {
+		return nil, err
+	}
+	_, _ = vsDB.ExecContext(ctx, "delete from vs_sticker_set_items where set_id = ? and document_id = ?", set.id, docId)
+	s.renumber(ctx, set.id, vsItemsDocIds(vsSetItems(ctx, set.id)))
+	return s.result(ctx, set)
+}
+
+func (s vsStickers) StickersChangeStickerPosition(ctx context.Context, in *mtproto.TLStickersChangeStickerPosition) (*mtproto.Messages_StickerSet, error) {
+	if vsDB == nil {
+		return nil, errVsInternal
+	}
+	docId := in.GetSticker().GetId()
+	set, err := s.ownSetByDoc(ctx, docId)
+	if err != nil {
+		return nil, err
+	}
+	ids := vsItemsDocIds(vsSetItems(ctx, set.id))
+	var rest []int64
+	for _, id := range ids {
+		if id != docId {
+			rest = append(rest, id)
+		}
+	}
+	p := int(in.GetPosition())
+	if p < 0 {
+		p = 0
+	}
+	if p > len(rest) {
+		p = len(rest)
+	}
+	out := append([]int64{}, rest[:p]...)
+	out = append(out, docId)
+	out = append(out, rest[p:]...)
+	s.renumber(ctx, set.id, out)
+	return s.result(ctx, set)
+}
+
+func (s vsStickers) StickersChangeSticker(ctx context.Context, in *mtproto.TLStickersChangeSticker) (*mtproto.Messages_StickerSet, error) {
+	if vsDB == nil {
+		return nil, errVsInternal
+	}
+	docId := in.GetSticker().GetId()
+	set, err := s.ownSetByDoc(ctx, docId)
+	if err != nil {
+		return nil, err
+	}
+	if in.GetEmoji() != nil {
+		e := strings.TrimSpace(in.GetEmoji().GetValue())
+		if e == "" {
+			return nil, errVsEmojiInvalid
+		}
+		_, _ = vsDB.ExecContext(ctx, "update vs_sticker_set_items set emoji = ? where set_id = ? and document_id = ?", e, set.id, docId)
+		if err = vsSetDocAttrs(ctx, docId, set, strings.Fields(e)[0]); err != nil {
+			return nil, err
+		}
+	}
+	if in.GetKeywords() != nil {
+		_, _ = vsDB.ExecContext(ctx, "update vs_sticker_set_items set keywords = ? where set_id = ? and document_id = ?", in.GetKeywords().GetValue(), set.id, docId)
+	}
+	return s.result(ctx, set)
+}
+
+func (s vsStickers) StickersReplaceSticker(ctx context.Context, in *mtproto.TLStickersReplaceSticker) (*mtproto.Messages_StickerSet, error) {
+	if vsDB == nil {
+		return nil, errVsInternal
+	}
+	oldId := in.GetSticker().GetId()
+	set, err := s.ownSetByDoc(ctx, oldId)
+	if err != nil {
+		return nil, err
+	}
+	pos := 0
+	_ = vsDB.QueryRowContext(ctx, "select pos from vs_sticker_set_items where set_id = ? and document_id = ?", set.id, oldId).Scan(&pos)
+	if err = s.addItem(ctx, set, in.GetNewSticker(), pos); err != nil {
+		return nil, err
+	}
+	_, _ = vsDB.ExecContext(ctx, "delete from vs_sticker_set_items where set_id = ? and document_id = ?", set.id, oldId)
+	return s.result(ctx, set)
+}
+
+func (s vsStickers) StickersRenameStickerSet(ctx context.Context, in *mtproto.TLStickersRenameStickerSet) (*mtproto.Messages_StickerSet, error) {
+	set, err := s.ownSet(ctx, in.GetStickerset())
+	if err != nil {
+		return nil, err
+	}
+	title := strings.TrimSpace(in.GetTitle())
+	if title == "" || len([]rune(title)) > 64 {
+		return nil, errVsTitleInvalid
+	}
+	_, _ = vsDB.ExecContext(ctx, "update vs_sticker_sets set title = ? where set_id = ?", title, set.id)
+	return s.result(ctx, set)
+}
+
+func (s vsStickers) StickersSetStickerSetThumb(ctx context.Context, in *mtproto.TLStickersSetStickerSetThumb) (*mtproto.Messages_StickerSet, error) {
+	set, err := s.ownSet(ctx, in.GetStickerset())
+	if err != nil {
+		return nil, err
+	}
+	thumb := in.GetThumb().GetId()
+	if in.GetThumbDocumentId() != nil {
+		thumb = in.GetThumbDocumentId().GetValue()
+	}
+	_, _ = vsDB.ExecContext(ctx, "update vs_sticker_sets set thumb_doc_id = ? where set_id = ?", thumb, set.id)
+	return s.result(ctx, set)
+}
+
+func (s vsStickers) StickersDeleteStickerSet(ctx context.Context, in *mtproto.TLStickersDeleteStickerSet) (*mtproto.Bool, error) {
+	set, err := s.ownSet(ctx, in.GetStickerset())
+	if err != nil {
+		return nil, err
+	}
+	// набор помечается удалённым (не стирается): стикеры в уже отправленных сообщениях остаются
+	_, _ = vsDB.ExecContext(ctx, "update vs_sticker_sets set deleted = 1 where set_id = ?", set.id)
+	_, _ = vsDB.ExecContext(ctx, "delete from vs_user_sticker_sets where set_id = ?", set.id)
+	vsNotifyMe(ctx, vsUpdStickerSets())
+	return mtproto.BoolTrue, nil
+}
+
+// ---------- RPCGifs ----------
+
+type vsGifs struct {
+	mtproto.UnimplementedRPCGifsServer
+}
+
+func (vsGifs) MessagesGetSavedGifs(ctx context.Context, in *mtproto.TLMessagesGetSavedGifs) (*mtproto.Messages_SavedGifs, error) {
+	r := &mtproto.Messages_SavedGifs{Gifs: []*mtproto.Document{}}
+	md := vsMD(ctx)
+	if vsDB == nil || md == nil {
+		return mtproto.MakeTLMessagesSavedGifs(r).To_Messages_SavedGifs(), nil
+	}
+	ids, _ := vsUserDocIds(ctx, md.UserId, vsstickers.ListGifs, vsstickers.MaxGifs)
+	docs := vsDocs(ctx, ids)
+	hashIds := make([]int64, 0, len(docs))
+	for _, d := range docs {
+		hashIds = append(hashIds, d.GetId())
+	}
+	r.Hash = vsstickers.HashIds(hashIds)
+	if in.GetHash() != 0 && in.GetHash() == r.Hash {
+		return mtproto.MakeTLMessagesSavedGifsNotModified(nil).To_Messages_SavedGifs(), nil
+	}
+	r.Gifs = docs
+	return mtproto.MakeTLMessagesSavedGifs(r).To_Messages_SavedGifs(), nil
+}
+
+func (vsGifs) MessagesSaveGif(ctx context.Context, in *mtproto.TLMessagesSaveGif) (*mtproto.Bool, error) {
+	md := vsMD(ctx)
+	if vsDB == nil || md == nil {
+		return mtproto.BoolTrue, nil
+	}
+	id := in.GetId().GetId()
+	if mtproto.FromBool(in.GetUnsave()) {
+		vsUserDocDel(ctx, md.UserId, vsstickers.ListGifs, id)
+	} else {
+		if vsDoc(ctx, id) == nil {
+			return nil, status.Error(mtproto.ErrBadRequest, "GIF_ID_INVALID")
+		}
+		vsUserDocAdd(ctx, md.UserId, vsstickers.ListGifs, id, vsstickers.MaxGifs)
+	}
+	vsNotifyMe(ctx, mtproto.MakeTLUpdateSavedGifs(&mtproto.Update{}).To_Update())
+	return mtproto.BoolTrue, nil
+}
diff --git a/app/tools/vsstickers/main.go b/app/tools/vsstickers/main.go
new file mode 100644
index 0000000..b4b7011
--- /dev/null
+++ b/app/tools/vsstickers/main.go
@@ -0,0 +1,188 @@
+// VSети: установщик официальных наборов стикеров.
+// Берёт bundle (manifest.json + файлы), кладёт файлы в S3 (documents/<id>.dat),
+// заводит документы в таблице documents и наборы в vs_sticker_sets / vs_sticker_set_items.
+// Повторный запуск безопасен: id стикеров постоянные (от ключа файла), записи заменяются.
+//
+//	vsstickers -bundle /tmp/bundle -media ../etc2/media.yaml -dfs ../etc2/dfs.yaml
+package main
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"hash/fnv"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	_ "github.com/go-sql-driver/mysql"
+	"github.com/minio/minio-go/v7"
+	"github.com/minio/minio-go/v7/pkg/credentials"
+	"github.com/teamgram/teamgram-server/pkg/vsstickers"
+	"github.com/zeromicro/go-zero/core/conf"
+	"github.com/zeromicro/go-zero/core/jsonx"
+)
+
+type manifest struct {
+	Source string `json:"source"`
+	Sets   []struct {
+		ShortName string `json:"short_name"`
+		Title     string `json:"title"`
+		Stickers  []struct {
+			File  string `json:"file"`
+			Key   string `json:"key"`
+			Emoji string `json:"emoji"`
+			Mime  string `json:"mime"`
+			Size  int64  `json:"size"`
+		} `json:"stickers"`
+	} `json:"sets"`
+}
+
+type mediaConf struct {
+	Mysql struct {
+		DSN string
+	}
+}
+
+type dfsConf struct {
+	Minio struct {
+		Endpoint        string
+		AccessKeyID     string
+		SecretAccessKey string
+		UseSSL          bool `json:",optional"`
+		Bucket          struct {
+			Documents string `json:",default=documents"`
+		} `json:",optional"`
+	}
+}
+
+type item struct {
+	id    int64
+	emoji string
+}
+
+const AnimatedEmojiShortName = "VSetiAnimatedEmoji"
+
+func docId(key string) int64 {
+	h := fnv.New64a()
+	_, _ = h.Write([]byte(key))
+	return vsstickers.OfficialDocIdBase + int64(h.Sum64()&0xffffffff)
+}
+
+func setAccessHash(setId int64) int64 {
+	h := fnv.New64a()
+	_, _ = fmt.Fprintf(h, "vseti-set-%d", setId)
+	return int64(h.Sum64() & 0x7fffffffffffffff)
+}
+
+func must(err error, what string) {
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "ОШИБКА %s: %v\n", what, err)
+		os.Exit(1)
+	}
+}
+
+func main() {
+	bundle := flag.String("bundle", "bundle", "папка с manifest.json")
+	mediaPath := flag.String("media", "../etc2/media.yaml", "конфиг media (Mysql)")
+	dfsPath := flag.String("dfs", "../etc2/dfs.yaml", "конфиг dfs (Minio)")
+	flag.Parse()
+
+	var mc mediaConf
+	conf.MustLoad(*mediaPath, &mc)
+	var dc dfsConf
+	conf.MustLoad(*dfsPath, &dc)
+
+	raw, err := os.ReadFile(filepath.Join(*bundle, "manifest.json"))
+	must(err, "manifest")
+	var man manifest
+	must(json.Unmarshal(raw, &man), "manifest json")
+
+	ctx := context.Background()
+	db, err := sql.Open("mysql", mc.Mysql.DSN)
+	must(err, "mysql")
+	must(db.PingContext(ctx), "mysql ping")
+	for _, q := range vsstickers.Schema {
+		_, err = db.ExecContext(ctx, q)
+		must(err, "schema")
+	}
+
+	mi, err := minio.New(dc.Minio.Endpoint, &minio.Options{
+		Creds:  credentials.NewStaticV4(dc.Minio.AccessKeyID, dc.Minio.SecretAccessKey, ""),
+		Secure: dc.Minio.UseSSL,
+	})
+	must(err, "s3")
+	bucket := dc.Minio.Bucket.Documents
+	if bucket == "" {
+		bucket = "documents"
+	}
+
+	now := time.Now().Unix()
+	var allItems []item
+	uploaded, skipped := 0, 0
+	for n, s := range man.Sets {
+		setId := vsstickers.OfficialSetIdBase + int64(n+1)
+		hash := setAccessHash(setId)
+		var items []item
+		kind := vsstickers.KindStatic
+		for _, st := range s.Stickers {
+			id := docId(st.Key)
+			kind = vsstickers.MimeKind(st.Mime)
+			data, err := os.ReadFile(filepath.Join(*bundle, st.File))
+			must(err, "файл "+st.File)
+			path := fmt.Sprintf("%d.dat", id)
+			if info, err := mi.StatObject(ctx, bucket, path, minio.StatObjectOptions{}); err == nil && info.Size == int64(len(data)) {
+				skipped++
+			} else {
+				_, err = mi.PutObject(ctx, bucket, path, bytes.NewReader(data), int64(len(data)), minio.PutObjectOptions{
+					ContentType: st.Mime, SendContentMd5: true,
+				})
+				must(err, "s3 put "+path)
+				uploaded++
+			}
+			attrs := vsstickers.StickerAttrs(st.Mime, st.Emoji, setId, hash, 512, 512, nil)
+			js, err := jsonx.MarshalToString(attrs)
+			must(err, "attrs")
+			ext := filepath.Ext(st.File)
+			_, err = db.ExecContext(ctx, "delete from documents where document_id = ?", id)
+			must(err, "documents delete")
+			_, err = db.ExecContext(ctx, "insert into documents(document_id, access_hash, dc_id, file_path, file_size, uploaded_file_name, ext, mime_type, thumb_id, video_thumb_id, attributes, date2) values (?, ?, 1, ?, ?, ?, ?, ?, 0, 0, ?, ?)",
+				id, int64(vsstickers.StorageType(st.Mime))<<32|(id&0xffffffff), path, len(data), filepath.Base(st.File), ext, st.Mime, js, now)
+			must(err, "documents insert")
+			items = append(items, item{id, st.Emoji})
+		}
+		saveSet(ctx, db, setId, hash, s.ShortName, s.Title, 1, kind, n+1, items, now)
+		allItems = append(allItems, items...)
+		fmt.Printf("набор %s «%s»: %d стикеров\n", s.ShortName, s.Title, len(items))
+	}
+	// Большие анимированные смайлы (inputStickerSetAnimatedEmoji): все стикеры, служебный набор.
+	aeId := vsstickers.OfficialSetIdBase + 0xFFFF
+	saveSet(ctx, db, aeId, setAccessHash(aeId), AnimatedEmojiShortName, "Animated Emoji", 2, vsstickers.KindAnimated, 0, allItems, now)
+	fmt.Printf("анимированные смайлы: %d\nфайлов загружено %d, уже были %d\nИсточник: %s\nГОТОВО\n", len(allItems), uploaded, skipped, man.Source)
+}
+
+func saveSet(ctx context.Context, db *sql.DB, setId, hash int64, short, title string, official, kind, featured int, items []item, now int64) {
+	_, err := db.ExecContext(ctx, "insert into vs_sticker_sets(set_id, access_hash, short_name, title, creator_id, official, kind, featured, deleted, created_at) values (?, ?, ?, ?, 0, ?, ?, ?, 0, ?) "+
+		"on duplicate key update access_hash=values(access_hash), short_name=values(short_name), title=values(title), official=values(official), kind=values(kind), featured=values(featured), deleted=0",
+		setId, hash, short, title, official, kind, featured, now)
+	must(err, "vs_sticker_sets "+short)
+	_, err = db.ExecContext(ctx, "delete from vs_sticker_set_items where set_id = ?", setId)
+	must(err, "items delete")
+	var sb strings.Builder
+	args := []any{}
+	for i, it := range items {
+		if i > 0 {
+			sb.WriteString(",")
+		}
+		sb.WriteString("(?, ?, ?, ?)")
+		args = append(args, setId, it.id, it.emoji, i)
+	}
+	if len(args) > 0 {
+		_, err = db.ExecContext(ctx, "insert into vs_sticker_set_items(set_id, document_id, emoji, pos) values "+sb.String(), args...)
+		must(err, "items insert")
+	}
+}
diff --git a/pkg/vsstickers/vsstickers.go b/pkg/vsstickers/vsstickers.go
new file mode 100644
index 0000000..c838d22
--- /dev/null
+++ b/pkg/vsstickers/vsstickers.go
@@ -0,0 +1,157 @@
+// Package vsstickers — VSети: общие части стикеров (схема таблиц, id, атрибуты документов).
+// Используется bff (наборы, недавние, избранные, GIF) и установщиком наборов cmd vsstickers.
+package vsstickers
+
+import (
+	"github.com/teamgram/proto/mtproto"
+)
+
+// Диапазоны id VSети (не пересекаются с idgen Teamgram и с реакциями 0x5653…).
+const (
+	OfficialSetIdBase = int64(0x5654000000000000) // + номер набора
+	OfficialDocIdBase = int64(0x5655000000000000) // + номер стикера
+)
+
+// Виды набора (vs_sticker_sets.kind).
+const (
+	KindStatic   = 0 // webp
+	KindAnimated = 1 // tgs (Lottie)
+	KindVideo    = 2 // webm
+)
+
+// Списки документов пользователя (vs_user_docs.list).
+const (
+	ListRecent         = 1
+	ListRecentAttached = 2
+	ListFaved          = 3
+	ListGifs           = 4
+)
+
+// Лимиты как у Telegram (для бесплатных аккаунтов у нас всё доступно).
+const (
+	MaxSetStickers = 120
+	MaxRecent      = 20
+	MaxFaved       = 5
+	MaxGifs        = 200
+)
+
+// Schema — таблицы VSети. Создаются bff при старте и установщиком (IF NOT EXISTS).
+var Schema = []string{
+	"CREATE TABLE IF NOT EXISTS `vs_sticker_sets` (" +
+		"`set_id` bigint NOT NULL, `access_hash` bigint NOT NULL, " +
+		"`short_name` varchar(64) NOT NULL, `title` varchar(128) NOT NULL, " +
+		"`creator_id` bigint NOT NULL DEFAULT 0, `official` tinyint NOT NULL DEFAULT 0, " +
+		"`kind` tinyint NOT NULL DEFAULT 0, `emojis` tinyint NOT NULL DEFAULT 0, " +
+		"`thumb_doc_id` bigint NOT NULL DEFAULT 0, `featured` int NOT NULL DEFAULT 0, " +
+		"`deleted` tinyint NOT NULL DEFAULT 0, `created_at` int NOT NULL DEFAULT 0, " +
+		"PRIMARY KEY (`set_id`), UNIQUE KEY `short_name` (`short_name`), KEY `creator_id` (`creator_id`)" +
+		") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
+	"CREATE TABLE IF NOT EXISTS `vs_sticker_set_items` (" +
+		"`set_id` bigint NOT NULL, `document_id` bigint NOT NULL, " +
+		"`emoji` varchar(64) NOT NULL DEFAULT '', `keywords` varchar(255) NOT NULL DEFAULT '', " +
+		"`pos` int NOT NULL DEFAULT 0, " +
+		"PRIMARY KEY (`set_id`, `document_id`), KEY `document_id` (`document_id`)" +
+		") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
+	"CREATE TABLE IF NOT EXISTS `vs_user_sticker_sets` (" +
+		"`user_id` bigint NOT NULL, `set_id` bigint NOT NULL, `pos` int NOT NULL DEFAULT 0, " +
+		"`archived` tinyint NOT NULL DEFAULT 0, `installed_at` int NOT NULL DEFAULT 0, " +
+		"PRIMARY KEY (`user_id`, `set_id`)" +
+		") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
+	"CREATE TABLE IF NOT EXISTS `vs_user_sticker_state` (" +
+		"`user_id` bigint NOT NULL, `defaults_done` int NOT NULL DEFAULT 0, `featured_read` int NOT NULL DEFAULT 0, " +
+		"PRIMARY KEY (`user_id`)" +
+		") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
+	"CREATE TABLE IF NOT EXISTS `vs_user_docs` (" +
+		"`user_id` bigint NOT NULL, `list` tinyint NOT NULL, `document_id` bigint NOT NULL, " +
+		"`date` int NOT NULL DEFAULT 0, " +
+		"PRIMARY KEY (`user_id`, `list`, `document_id`), KEY `user_list_date` (`user_id`, `list`, `date`)" +
+		") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
+}
+
+// CalcHash — хэш Telegram для списков (клиенты считают так же).
+func CalcHash(acc int64, v int64) int64 {
+	u := uint64(acc)
+	u ^= u >> 21
+	u ^= u << 35
+	u ^= u >> 4
+	u += uint64(v)
+	return int64(u)
+}
+
+func HashIds(ids []int64) int64 {
+	var h int64
+	for _, id := range ids {
+		h = CalcHash(h, id)
+	}
+	return h
+}
+
+// SetHash — hash:int набора (по документам).
+func SetHash(docIds []int64) int32 {
+	return int32(HashIds(docIds))
+}
+
+// MimeKind — вид набора по типу файла.
+func MimeKind(mime string) int {
+	switch mime {
+	case "application/x-tgsticker":
+		return KindAnimated
+	case "video/webm":
+		return KindVideo
+	}
+	return KindStatic
+}
+
+// StickerAttrs — атрибуты документа-стикера (как у Telegram).
+func StickerAttrs(mime, alt string, setId, setHash int64, w, h int32, keep []*mtproto.DocumentAttribute) []*mtproto.DocumentAttribute {
+	var set *mtproto.InputStickerSet
+	if setId != 0 {
+		set = mtproto.MakeTLInputStickerSetID(&mtproto.InputStickerSet{Id: setId, AccessHash: setHash}).To_InputStickerSet()
+	} else {
+		set = mtproto.MakeTLInputStickerSetEmpty(nil).To_InputStickerSet()
+	}
+	attrs := []*mtproto.DocumentAttribute{}
+	hasSize, hasName := false, false
+	for _, a := range keep {
+		switch a.GetPredicateName() {
+		case mtproto.Predicate_documentAttributeSticker, mtproto.Predicate_documentAttributeCustomEmoji:
+			continue
+		case mtproto.Predicate_documentAttributeImageSize:
+			hasSize = true
+		case mtproto.Predicate_documentAttributeVideo:
+			hasSize = true
+		case mtproto.Predicate_documentAttributeFilename:
+			hasName = true
+		}
+		attrs = append(attrs, a)
+	}
+	if !hasSize && w > 0 {
+		attrs = append(attrs, mtproto.MakeTLDocumentAttributeImageSize(&mtproto.DocumentAttribute{W: w, H: h}).To_DocumentAttribute())
+	}
+	attrs = append(attrs, mtproto.MakeTLDocumentAttributeSticker(&mtproto.DocumentAttribute{
+		Alt:        alt,
+		Stickerset: set,
+	}).To_DocumentAttribute())
+	if !hasName {
+		name := "sticker.webp"
+		switch mime {
+		case "application/x-tgsticker":
+			name = "AnimatedSticker.tgs"
+		case "video/webm":
+			name = "sticker.webm"
+		}
+		attrs = append(attrs, mtproto.MakeTLDocumentAttributeFilename(&mtproto.DocumentAttribute{FileName: name}).To_DocumentAttribute())
+	}
+	return attrs
+}
+
+// StorageType — старшие 32 бита access_hash документа (тип файла для upload.file).
+func StorageType(mime string) int32 {
+	switch mime {
+	case "image/webp":
+		return int32(mtproto.TLConstructor_CRC32_storage_fileWebp)
+	case "video/webm", "video/mp4":
+		return int32(mtproto.TLConstructor_CRC32_storage_fileMp4)
+	}
+	return int32(mtproto.TLConstructor_CRC32_storage_fileUnknown)
+}
