+// vsStickersByEmoji — стикеры с этим смайлом: сначала из установленных наборов, потом из остальных официальных.
+func vsStickersByEmoji(ctx context.Context, me int64, emoticon string, limit int, onlyInstalled bool) []int64 {
+	e := vsNormEmoji(strings.TrimSpace(emoticon))
+	if e == "" {
+		return nil
+	}
+	q := "select i.document_id, i.emoji, (u.set_id is not null) as inst from vs_sticker_set_items i " +
+		"join vs_sticker_sets s on s.set_id = i.set_id and s.deleted = 0 " +
+		"left join vs_user_sticker_sets u on u.set_id = i.set_id and u.user_id = ? and u.archived = 0 " +
+		"where i.emoji like ? "
+	if onlyInstalled {
+		q += "and u.set_id is not null "
+	} else {
+		q += "and (u.set_id is not null or s.official = 1) "
+	}
+	q += "order by inst desc, u.pos, i.pos limit 500"
+	rows, err := vsDB.QueryContext(ctx, q, me, "%"+e+"%")
+	if err != nil {
+		logx.WithContext(ctx).Errorf("vs stickers by emoji: %v", err)
+		return nil
+	}
+	defer rows.Close()
+	seen := map[int64]bool{}
+	var ids []int64
+	for rows.Next() {
+		var id int64
+		var em string
+		var inst bool
+		if rows.Scan(&id, &em, &inst) != nil || seen[id] {
+			continue
+		}
+		match := false
+		for _, x := range vsSplitEmoji(em) {
+			if x == e {
+				match = true
+			}
+		}
+		if match {
+			seen[id] = true
+			ids = append(ids, id)
+			if len(ids) >= limit {
+				break
+			}
+		}
+	}
+	return ids
+}
