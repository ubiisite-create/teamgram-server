diff --git a/app/bff/bff/internal/server/vs_stickers.go b/app/bff/bff/internal/server/vs_stickers.go
new file mode 100644
index 0000000..2bdfb11
--- /dev/null
+++ b/app/bff/bff/internal/server/vs_stickers.go
@@ -0,0 +1,1309 @@
+// VSети: стикеры и сохранённые GIF (как в Telegram).
+// Наборы — таблицы vs_sticker_sets / vs_sticker_set_items, установленные у пользователя —
+// vs_user_sticker_sets, недавние/избранные/GIF — vs_user_docs (см. pkg/vsstickers).
+// Сами файлы стикеров — обычные документы (таблица documents + S3), их отдаёт media.
+package server
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"math/rand"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+	"unicode"
+
+	_ "github.com/go-sql-driver/mysql"
+	"github.com/teamgram/marmota/pkg/net/rpcx"
+	"github.com/teamgram/proto/mtproto"
+	"github.com/teamgram/teamgram-server/app/bff/bff/internal/config"
+	syncpb "github.com/teamgram/teamgram-server/app/messenger/sync/sync"
+	media_client "github.com/teamgram/teamgram-server/app/service/media/client"
+	mediapb "github.com/teamgram/teamgram-server/app/service/media/media"
+	"github.com/teamgram/teamgram-server/pkg/vsstickers"
+
+	"github.com/zeromicro/go-zero/core/jsonx"
+	"github.com/zeromicro/go-zero/core/logx"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/types/known/wrapperspb"
+)
+
+const vsAnimatedEmojiShortName = "VSetiAnimatedEmoji"
+
+var (
+	vsDB       *sql.DB
+	vsMediaCli media_client.MediaClient
+
+	errVsShortNameInvalid  = status.Error(mtproto.ErrBadRequest, "SHORT_NAME_INVALID")
+	errVsShortNameOccupied = status.Error(mtproto.ErrBadRequest, "SHORT_NAME_OCCUPIED")
+	errVsTitleInvalid      = status.Error(mtproto.ErrBadRequest, "PACK_TITLE_INVALID")
+	errVsStickersTooMuch   = status.Error(mtproto.ErrBadRequest, "STICKERS_TOO_MUCH")
+	errVsStickerInvalid    = status.Error(mtproto.ErrBadRequest, "STICKER_ID_INVALID")
+	errVsEmojiInvalid      = status.Error(mtproto.ErrBadRequest, "STICKER_EMOJI_INVALID")
+	errVsInternal          = mtproto.ErrInternalServerError
+
+	reVsShortName = regexp.MustCompile(`^[A-Za-z][A-Za-z0-9_]{0,63}$`)
+)
+
+func initVsStickers(c config.Config) {
+	vsMediaCli = media_client.NewMediaClient(rpcx.GetCachedRpcClient(c.MediaClient))
+	if c.VsMysqlDSN == "" {
+		logx.Errorf("VSети стикеры: нет VsMysqlDSN в bff.yaml — стикеры выключены")
+		return
+	}
+	db, err := sql.Open("mysql", c.VsMysqlDSN)
+	if err != nil {
+		logx.Errorf("VSети стикеры: mysql: %v", err)
+		return
+	}
+	db.SetMaxOpenConns(16)
+	db.SetMaxIdleConns(8)
+	db.SetConnMaxLifetime(time.Hour)
+	for _, q := range vsstickers.Schema {
+		if _, err = db.Exec(q); err != nil {
+			logx.Errorf("VSети стикеры: схема: %v", err)
+			return
+		}
+	}
+	vsDB = db
+}
+
+// ---------- данные ----------
+
+type vsSet struct {
+	id, accessHash int64
+	short, title   string
+	creator        int64
+	official, kind int
+	thumbDoc       int64
+	featured       int
+	created        int64
+}
+
+type vsSetItem struct {
+	docId int64
+	emoji string
+}
+
+type vsUserSet struct {
+	archived  bool
+	installed int32
+	pos       int
+}
+
+const vsSetCols = "set_id, access_hash, short_name, title, creator_id, official, kind, thumb_doc_id, featured, created_at"
+
+func vsScanSets(rows *sql.Rows, err error) []*vsSet {
+	if err != nil {
+		logx.Errorf("vs stickers query: %v", err)
+		return nil
+	}
+	defer rows.Close()
+	var r []*vsSet
+	for rows.Next() {
+		s := &vsSet{}
+		if rows.Scan(&s.id, &s.accessHash, &s.short, &s.title, &s.creator, &s.official, &s.kind, &s.thumbDoc, &s.featured, &s.created) == nil {
+			r = append(r, s)
+		}
+	}
+	return r
+}
+
+func vsGetSetById(ctx context.Context, id int64) *vsSet {
+	l := vsScanSets(vsDB.QueryContext(ctx, "select "+vsSetCols+" from vs_sticker_sets where set_id = ? and deleted = 0", id))
+	if len(l) == 0 {
+		return nil
+	}
+	return l[0]
+}
+
+func vsGetSetByShort(ctx context.Context, short string) *vsSet {
+	l := vsScanSets(vsDB.QueryContext(ctx, "select "+vsSetCols+" from vs_sticker_sets where short_name = ? and deleted = 0", short))
+	if len(l) == 0 {
+		return nil
+	}
+	return l[0]
+}
+
+func vsResolveSet(ctx context.Context, in *mtproto.InputStickerSet) (*vsSet, error) {
+	if vsDB == nil || in == nil {
+		return nil, mtproto.ErrStickersetInvalid
+	}
+	var s *vsSet
+	switch in.GetPredicateName() {
+	case mtproto.Predicate_inputStickerSetID:
+		s = vsGetSetById(ctx, in.GetId())
+	case mtproto.Predicate_inputStickerSetShortName:
+		s = vsGetSetByShort(ctx, in.GetShortName())
+	case mtproto.Predicate_inputStickerSetAnimatedEmoji:
+		s = vsGetSetByShort(ctx, vsAnimatedEmojiShortName)
+	}
+	if s == nil {
+		return nil, mtproto.ErrStickersetInvalid
+	}
+	return s, nil
+}
+
+func vsSetItems(ctx context.Context, setId int64) []vsSetItem {
+	rows, err := vsDB.QueryContext(ctx, "select document_id, emoji from vs_sticker_set_items where set_id = ? order by pos, document_id", setId)
+	if err != nil {
+		return nil
+	}
+	defer rows.Close()
+	var r []vsSetItem
+	for rows.Next() {
+		var it vsSetItem
+		if rows.Scan(&it.docId, &it.emoji) == nil {
+			r = append(r, it)
+		}
+	}
+	return r
+}
+
+func vsItemsDocIds(items []vsSetItem) []int64 {
+	ids := make([]int64, 0, len(items))
+	for _, it := range items {
+		ids = append(ids, it.docId)
+	}
+	return ids
+}
+
+// vsDocs — документы по id (в том же порядке, пропуская отсутствующие).
+func vsDocs(ctx context.Context, ids []int64) []*mtproto.Document {
+	if len(ids) == 0 {
+		return []*mtproto.Document{}
+	}
+	m := map[int64]*mtproto.Document{}
+	for i := 0; i < len(ids); i += 200 {
+		j := i + 200
+		if j > len(ids) {
+			j = len(ids)
+		}
+		v, err := vsMediaCli.MediaGetDocumentList(ctx, &mediapb.TLMediaGetDocumentList{IdList: ids[i:j]})
+		if err != nil {
+			logx.WithContext(ctx).Errorf("vs stickers: media.getDocumentList: %v", err)
+			continue
+		}
+		for _, d := range v.GetDatas() {
+			if d.GetPredicateName() == mtproto.Predicate_document {
+				m[d.GetId()] = d
+			}
+		}
+	}
+	r := make([]*mtproto.Document, 0, len(ids))
+	for _, id := range ids {
+		if d, ok := m[id]; ok {
+			r = append(r, d)
+		}
+	}
+	return r
+}
+
+func vsDoc(ctx context.Context, id int64) *mtproto.Document {
+	l := vsDocs(ctx, []int64{id})
+	if len(l) == 0 {
+		return nil
+	}
+	return l[0]
+}
+
+func vsNormEmoji(s string) string {
+	return strings.ReplaceAll(s, "️", "")
+}
+
+func vsDocAlt(d *mtproto.Document) (string, bool) {
+	for _, a := range d.GetAttributes() {
+		if a.GetPredicateName() == mtproto.Predicate_documentAttributeSticker {
+			return a.GetAlt(), true
+		}
+	}
+	return "", false
+}
+
+func vsDocIsGif(d *mtproto.Document) bool {
+	for _, a := range d.GetAttributes() {
+		if a.GetPredicateName() == mtproto.Predicate_documentAttributeAnimated {
+			return true
+		}
+	}
+	return false
+}
+
+func vsPacks(items []vsSetItem) []*mtproto.StickerPack {
+	order := []string{}
+	m := map[string][]int64{}
+	for _, it := range items {
+		for _, e := range vsSplitEmoji(it.emoji) {
+			if _, ok := m[e]; !ok {
+				order = append(order, e)
+			}
+			m[e] = append(m[e], it.docId)
+		}
+	}
+	r := make([]*mtproto.StickerPack, 0, len(order))
+	for _, e := range order {
+		r = append(r, mtproto.MakeTLStickerPack(&mtproto.StickerPack{Emoticon: e, Documents: m[e]}).To_StickerPack())
+	}
+	return r
+}
+
+// vsSplitEmoji — в поле emoji может быть несколько смайлов через пробел.
+func vsSplitEmoji(s string) []string {
+	var r []string
+	for _, p := range strings.Fields(s) {
+		if p = vsNormEmoji(p); p != "" {
+			r = append(r, p)
+		}
+	}
+	return r
+}
+
+func vsDocPacks(docs []*mtproto.Document) []*mtproto.StickerPack {
+	items := make([]vsSetItem, 0, len(docs))
+	for _, d := range docs {
+		if alt, ok := vsDocAlt(d); ok && alt != "" {
+			items = append(items, vsSetItem{docId: d.GetId(), emoji: alt})
+		}
+	}
+	return vsPacks(items)
+}
+
+func vsUserSets(ctx context.Context, userId int64) map[int64]*vsUserSet {
+	rows, err := vsDB.QueryContext(ctx, "select set_id, archived, installed_at, pos from vs_user_sticker_sets where user_id = ?", userId)
+	r := map[int64]*vsUserSet{}
+	if err != nil {
+		return r
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var id int64
+		u := &vsUserSet{}
+		var a int
+		if rows.Scan(&id, &a, &u.installed, &u.pos) == nil {
+			u.archived = a != 0
+			r[id] = u
+		}
+	}
+	return r
+}
+
+func vsTLSet(s *vsSet, items []vsSetItem, u *vsUserSet, me int64) *mtproto.StickerSet {
+	ss := &mtproto.StickerSet{
+		Official:   s.official > 0,
+		Creator:    s.creator != 0 && s.creator == me,
+		Id:         s.id,
+		AccessHash: s.accessHash,
+		Title:      s.title,
+		ShortName:  s.short,
+		Count:      int32(len(items)),
+		Hash:       vsstickers.SetHash(vsItemsDocIds(items)),
+		Animated:   s.kind == vsstickers.KindAnimated,
+		Videos:     s.kind == vsstickers.KindVideo,
+	}
+	if u != nil {
+		ss.Archived = u.archived
+		ss.InstalledDate = wrapperspb.Int32(u.installed)
+	}
+	return mtproto.MakeTLStickerSet(ss).To_StickerSet()
+}
+
+func vsFullSet(ctx context.Context, s *vsSet, u *vsUserSet, me int64) *mtproto.Messages_StickerSet {
+	items := vsSetItems(ctx, s.id)
+	return mtproto.MakeTLMessagesStickerSet(&mtproto.Messages_StickerSet{
+		Set:       vsTLSet(s, items, u, me),
+		Packs:     vsPacks(items),
+		Keywords:  []*mtproto.StickerKeyword{},
+		Documents: vsDocs(ctx, vsItemsDocIds(items)),
+	}).To_Messages_StickerSet()
+}
+
+func vsCovered(ctx context.Context, s *vsSet, u *vsUserSet, me int64, full bool) *mtproto.StickerSetCovered {
+	items := vsSetItems(ctx, s.id)
+	set := vsTLSet(s, items, u, me)
+	if full {
+		return mtproto.MakeTLStickerSetFullCovered(&mtproto.StickerSetCovered{
+			Set:       set,
+			Packs:     vsPacks(items),
+			Keywords:  []*mtproto.StickerKeyword{},
+			Documents: vsDocs(ctx, vsItemsDocIds(items)),
+		}).To_StickerSetCovered()
+	}
+	if len(items) == 0 {
+		return mtproto.MakeTLStickerSetNoCovered(&mtproto.StickerSetCovered{Set: set}).To_StickerSetCovered()
+	}
+	cover := vsDoc(ctx, items[0].docId)
+	if cover == nil {
+		return mtproto.MakeTLStickerSetNoCovered(&mtproto.StickerSetCovered{Set: set}).To_StickerSetCovered()
+	}
+	return mtproto.MakeTLStickerSetCovered(&mtproto.StickerSetCovered{Set: set, Cover: cover}).To_StickerSetCovered()
+}
+
+// vsEnsureDefaults — новому пользователю ставим официальные наборы VSети (как Telegram ставит стандартные).
+func vsEnsureDefaults(ctx context.Context, userId int64) {
+	var done int
+	err := vsDB.QueryRowContext(ctx, "select defaults_done from vs_user_sticker_state where user_id = ?", userId).Scan(&done)
+	if err == nil && done != 0 {
+		return
+	}
+	now := time.Now().Unix()
+	_, _ = vsDB.ExecContext(ctx, "insert ignore into vs_user_sticker_sets(user_id, set_id, pos, archived, installed_at) "+
+		"select ?, set_id, featured, 0, ? from vs_sticker_sets where official = 1 and deleted = 0", userId, now)
+	_, _ = vsDB.ExecContext(ctx, "insert into vs_user_sticker_state(user_id, defaults_done, featured_read) values (?, 1, ?) "+
+		"on duplicate key update defaults_done = 1", userId, now)
+}
+
+func vsInstall(ctx context.Context, userId, setId int64, archived bool) {
+	var minPos sql.NullInt64
+	_ = vsDB.QueryRowContext(ctx, "select min(pos) from vs_user_sticker_sets where user_id = ?", userId).Scan(&minPos)
+	pos := int64(0)
+	if minPos.Valid {
+		pos = minPos.Int64 - 1
+	}
+	a := 0
+	if archived {
+		a = 1
+	}
+	_, _ = vsDB.ExecContext(ctx, "insert into vs_user_sticker_sets(user_id, set_id, pos, archived, installed_at) values (?, ?, ?, ?, ?) "+
+		"on duplicate key update pos = values(pos), archived = values(archived), installed_at = values(installed_at)",
+		userId, setId, pos, a, time.Now().Unix())
+}
+
+// vsNotifyMe — то же изменение на других устройствах пользователя.
+func vsNotifyMe(ctx context.Context, updates ...*mtproto.Update) {
+	if vsSyncCli == nil {
+		return
+	}
+	md := vsMD(ctx)
+	if md == nil {
+		return
+	}
+	_, _ = vsSyncCli.SyncUpdatesNotMe(ctx, &syncpb.TLSyncUpdatesNotMe{
+		UserId:        md.UserId,
+		PermAuthKeyId: md.PermAuthKeyId,
+		Updates: mtproto.MakeTLUpdates(&mtproto.Updates{
+			Updates: updates,
+			Users:   []*mtproto.User{},
+			Chats:   []*mtproto.Chat{},
+			Date:    int32(time.Now().Unix()),
+		}).To_Updates(),
+	})
+}
+
+func vsUpdStickerSets() *mtproto.Update {
+	return mtproto.MakeTLUpdateStickerSets(&mtproto.Update{}).To_Update()
+}
+
+// --- недавние / избранные / GIF ---
+
+func vsUserDocIds(ctx context.Context, userId int64, list, limit int) ([]int64, []int32) {
+	rows, err := vsDB.QueryContext(ctx, "select document_id, date from vs_user_docs where user_id = ? and list = ? order by date desc, document_id desc limit ?", userId, list, limit)
+	if err != nil {
+		return nil, nil
+	}
+	defer rows.Close()
+	var ids []int64
+	var dates []int32
+	for rows.Next() {
+		var id int64
+		var d int32
+		if rows.Scan(&id, &d) == nil {
+			ids = append(ids, id)
+			dates = append(dates, d)
+		}
+	}
+	return ids, dates
+}
+
+func vsUserDocAdd(ctx context.Context, userId int64, list int, docId int64, limit int) {
+	_, _ = vsDB.ExecContext(ctx, "insert into vs_user_docs(user_id, list, document_id, date) values (?, ?, ?, ?) on duplicate key update date = values(date)",
+		userId, list, docId, time.Now().Unix())
+	ids, _ := vsUserDocIds(ctx, userId, list, 1000)
+	for i := limit; i < len(ids); i++ {
+		_, _ = vsDB.ExecContext(ctx, "delete from vs_user_docs where user_id = ? and list = ? and document_id = ?", userId, list, ids[i])
+	}
+}
+
+func vsUserDocDel(ctx context.Context, userId int64, list int, docId int64) {
+	_, _ = vsDB.ExecContext(ctx, "delete from vs_user_docs where user_id = ? and list = ? and document_id = ?", userId, list, docId)
+}
+
+// vsAfterSendMedia — как Telegram: отправленный стикер попадает в «Недавние», отправленная GIF — в сохранённые.
+func vsAfterSendMedia(ctx context.Context, media *mtproto.InputMedia) {
+	if vsDB == nil || media.GetPredicateName() != mtproto.Predicate_inputMediaDocument {
+		return
+	}
+	md := vsMD(ctx)
+	id := media.GetId_INPUTDOCUMENT().GetId()
+	if md == nil || id == 0 {
+		return
+	}
+	d := vsDoc(ctx, id)
+	if d == nil {
+		return
+	}
+	if _, ok := vsDocAlt(d); ok {
+		vsUserDocAdd(ctx, md.UserId, vsstickers.ListRecent, id, vsstickers.MaxRecent)
+		vsNotifyMe(ctx, mtproto.MakeTLUpdateRecentStickers(&mtproto.Update{}).To_Update())
+	} else if vsDocIsGif(d) {
+		vsUserDocAdd(ctx, md.UserId, vsstickers.ListGifs, id, vsstickers.MaxGifs)
+		vsNotifyMe(ctx, mtproto.MakeTLUpdateSavedGifs(&mtproto.Update{}).To_Update())
+	}
+}
+
+// --- свои наборы: атрибуты документа ---
+
+func vsSetDocAttrs(ctx context.Context, docId int64, s *vsSet, emoji string) error {
+	d := vsDoc(ctx, docId)
+	if d == nil {
+		return errVsStickerInvalid
+	}
+	var w, h int32 = 512, 512
+	attrs := vsstickers.StickerAttrs(d.GetMimeType(), emoji, s.id, s.accessHash, w, h, d.GetAttributes())
+	js, err := jsonx.MarshalToString(attrs)
+	if err != nil {
+		return errVsInternal
+	}
+	if _, err = vsDB.ExecContext(ctx, "update documents set attributes = ? where document_id = ?", js, docId); err != nil {
+		logx.WithContext(ctx).Errorf("vs stickers: documents update: %v", err)
+		return errVsInternal
+	}
+	// кэш media (go-zero cache: ключ document_<id>)
+	if vsKV != nil {
+		_, _ = vsKV.Del(fmt.Sprintf("document_%d", docId))
+	}
+	return nil
+}
+
+func vsCheckDocMime(d *mtproto.Document) bool {
+	switch d.GetMimeType() {
+	case "image/webp", "image/png", "application/x-tgsticker", "video/webm":
+		return true
+	}
+	return false
+}
+
+func vsTranslit(s string) string {
+	tr := map[rune]string{'а': "a", 'б': "b", 'в': "v", 'г': "g", 'д': "d", 'е': "e", 'ё': "e", 'ж': "zh", 'з': "z", 'и': "i", 'й': "y",
+		'к': "k", 'л': "l", 'м': "m", 'н': "n", 'о': "o", 'п': "p", 'р': "r", 'с': "s", 'т': "t", 'у': "u", 'ф': "f", 'х': "h",
+		'ц': "ts", 'ч': "ch", 'ш': "sh", 'щ': "sch", 'ъ': "", 'ы': "y", 'ь': "", 'э': "e", 'ю': "yu", 'я': "ya"}
+	var b strings.Builder
+	for _, r := range strings.ToLower(s) {
+		switch {
+		case r < 128 && (unicode.IsLetter(r) || unicode.IsDigit(r)):
+			b.WriteRune(r)
+		case tr[r] != "":
+			b.WriteString(tr[r])
+		case unicode.IsSpace(r) || r == '_' || r == '-':
+			if b.Len() > 0 && !strings.HasSuffix(b.String(), "_") {
+				b.WriteByte('_')
+			}
+		}
+	}
+	r := strings.Trim(b.String(), "_")
+	if r == "" || !unicode.IsLetter(rune(r[0])) {
+		r = "set_" + r
+	}
+	if len(r) > 50 {
+		r = r[:50]
+	}
+	return r
+}
