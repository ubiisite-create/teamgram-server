+func (s vsStickers) MessagesToggleStickerSets(ctx context.Context, in *mtproto.TLMessagesToggleStickerSets) (*mtproto.Bool, error) {
+	me := s.me(ctx)
+	for _, is := range in.GetStickersets() {
+		set, err := vsResolveSet(ctx, is)
+		if err != nil {
+			continue
+		}
+		switch {
+		case in.GetUninstall():
+			_, _ = vsDB.ExecContext(ctx, "delete from vs_user_sticker_sets where user_id = ? and set_id = ?", me, set.id)
+		case in.GetArchive():
+			vsInstall(ctx, me, set.id, true)
+		case in.GetUnarchive():
+			vsInstall(ctx, me, set.id, false)
+		}
+	}
+	vsNotifyMe(ctx, vsUpdStickerSets())
+	return mtproto.BoolTrue, nil
+}
