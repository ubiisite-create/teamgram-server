+func (s vsStickers) MessagesGetAllStickers(ctx context.Context, in *mtproto.TLMessagesGetAllStickers) (*mtproto.Messages_AllStickers, error) {
+	if vsDB == nil {
+		return mtproto.MakeTLMessagesAllStickers(&mtproto.Messages_AllStickers{Sets: []*mtproto.StickerSet{}}).To_Messages_AllStickers(), nil
+	}
+	me := s.me(ctx)
+	vsEnsureDefaults(ctx, me)
+	us := vsUserSets(ctx, me)
+	type row struct {
+		s *vsSet
+		u *vsUserSet
+	}
+	var rs []row
+	for id, u := range us {
+		if u.archived {
+			continue
+		}
+		if set := vsGetSetById(ctx, id); set != nil {
+			rs = append(rs, row{set, u})
+		}
+	}
+	sort.SliceStable(rs, func(i, j int) bool {
+		if rs[i].u.pos != rs[j].u.pos {
+			return rs[i].u.pos < rs[j].u.pos
+		}
+		return rs[i].u.installed > rs[j].u.installed
+	})
+	sets := make([]*mtproto.StickerSet, 0, len(rs))
+	var hash int64
+	for _, r := range rs {
+		ts := vsTLSet(r.s, vsSetItems(ctx, r.s.id), r.u, me)
+		hash = vsstickers.CalcHash(hash, int64(ts.Hash))
+		sets = append(sets, ts)
+	}
+	if in.GetHash() != 0 && in.GetHash() == hash {
+		return mtproto.MakeTLMessagesAllStickersNotModified(nil).To_Messages_AllStickers(), nil
+	}
+	return mtproto.MakeTLMessagesAllStickers(&mtproto.Messages_AllStickers{Hash: hash, Sets: sets}).To_Messages_AllStickers(), nil
+}
+
+func (s vsStickers) MessagesGetStickerSet(ctx context.Context, in *mtproto.TLMessagesGetStickerSet) (*mtproto.Messages_StickerSet, error) {
+	set, err := vsResolveSet(ctx, in.GetStickerset())
+	if err != nil {
+		return nil, err
+	}
+	me := s.me(ctx)
+	full := vsFullSet(ctx, set, vsUserSets(ctx, me)[set.id], me)
+	if in.GetHash() != 0 && in.GetHash() == full.GetSet().GetHash() {
+		return mtproto.MakeTLMessagesStickerSetNotModified(nil).To_Messages_StickerSet(), nil
+	}
+	return full, nil
+}
