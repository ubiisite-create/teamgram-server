+func (s vsStickers) MessagesGetFeaturedStickers(ctx context.Context, in *mtproto.TLMessagesGetFeaturedStickers) (*mtproto.Messages_FeaturedStickers, error) {
+	r := &mtproto.Messages_FeaturedStickers{Sets: []*mtproto.StickerSetCovered{}, Unread: []int64{}}
+	if vsDB == nil {
+		return mtproto.MakeTLMessagesFeaturedStickers(r).To_Messages_FeaturedStickers(), nil
+	}
+	me := s.me(ctx)
+	vsEnsureDefaults(ctx, me)
+	var readAt int64
+	_ = vsDB.QueryRowContext(ctx, "select featured_read from vs_user_sticker_state where user_id = ?", me).Scan(&readAt)
+	us := vsUserSets(ctx, me)
+	sets := vsScanSets(vsDB.QueryContext(ctx, "select "+vsSetCols+" from vs_sticker_sets where deleted = 0 and official = 1 order by featured, set_id"))
+	var hash int64
+	for _, set := range sets {
+		if u, ok := us[set.id]; ok && !u.archived {
+			continue
+		}
+		r.Sets = append(r.Sets, vsCovered(ctx, set, us[set.id], me, true))
+		hash = vsstickers.CalcHash(hash, set.id)
+		if set.created > readAt {
+			r.Unread = append(r.Unread, set.id)
+			hash = vsstickers.CalcHash(hash, 1)
+		}
+	}
+	r.Count = int32(len(r.Sets))
+	r.Hash = hash
+	if in.GetHash() != 0 && in.GetHash() == hash {
+		return mtproto.MakeTLMessagesFeaturedStickersNotModified(&mtproto.Messages_FeaturedStickers{Count: r.Count}).To_Messages_FeaturedStickers(), nil
+	}
+	return mtproto.MakeTLMessagesFeaturedStickers(r).To_Messages_FeaturedStickers(), nil
+}
